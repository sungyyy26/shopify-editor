SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=your-app-client-id
SHOPIFY_API_SECRET=your-app-client-secret
APP_URL=http://localhost:3000
PORT=3000

# SHOPIFY_ADMIN_ACCESS_TOKEN is filled in automatically after you connect
# via http://localhost:3000/auth - you don't need to set it by hand.
